<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>wcount</AssemblyName>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>WCount</PackageId>
        <Title>WCount</Title>
        <Authors>Alastair Lundy</Authors>
        <IsTrimmable>true</IsTrimmable>
        <IsAoTCompatible>true</IsAoTCompatible>
        <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>

        <!-- First-ever gallery release: 1.0.0 (T008). The csproj is the single
             source of truth for the published version; no workflow takes a
             version input (T013). -->
        <Version>1.0.0</Version>

        <!-- Installable with `dotnet tool install WCount` (T009); one
             framework-dependent build configuration is shared with the WinGet
             artifact (T015). -->
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>wcount</ToolCommandName>

        <!-- Roll forward within the declared runtime major only; newer majors
             arrive side-by-side through the WinGet runtime dependency (T017). -->
        <RollForward>LatestMinor</RollForward>

        <!-- Published binaries ship ReadyToRun images (T016). Trimming applies
             where the deployment mode allows it: the linker rejects
             framework-dependent publishing (NETSDK1102), so the shared
             framework-dependent configuration keeps the trim analyzer on with
             linker warnings as errors instead — a dirty trim fails the build. -->
        <PublishReadyToRun>true</PublishReadyToRun>
        <PublishTrimmed Condition="'$(SelfContained)' == 'true'">true</PublishTrimmed>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2104;IL2070;IL2067;IL2065;IL2062;IL2072;IL2075;IL2080;IL2087;IL2090;IL2092</WarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="System.CommandLine"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\lib\WCountLib\WCountLib.csproj" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Update="Localizations\Resources.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Localizations\Resources.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>Resources.resx</DependentUpon>
      </Compile>
    </ItemGroup>

</Project>
