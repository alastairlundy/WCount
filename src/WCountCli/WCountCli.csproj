<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>wcount</AssemblyName>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>WCount</PackageId>
        <Title>WCount</Title>
        <Authors>Alastair Lundy</Authors>
        <IsTrimmable>true</IsTrimmable>
        <IsAoTCompatible>true</IsAoTCompatible>
        <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>

        <!-- First-ever gallery release: 1.0.0. The csproj is the single
             source of truth for the published version; no workflow takes a
             version input. -->
        <Version>1.0.0</Version>

        <!-- Installable with `dotnet tool install WCount`; one
             framework-dependent build configuration is shared with the WinGet
             artifact. -->
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>wcount</ToolCommandName>

        <!-- Roll forward within the declared runtime major only; newer majors
             arrive side-by-side through the WinGet runtime dependency. -->
        <RollForward>LatestMinor</RollForward>

        <!-- Trimming is not used for either ship channel: the NuGet tool
             package ships as plain IL, and the WinGet publish is
             framework-dependent (the linker rejects that mode anyway,
             NETSDK1102). Trim warnings are kept instead: IsTrimmable leaves
             the trim analyzer running so IL warnings surface on every build,
             and continuous integration builds with -warnaserror so a dirty
             trim fails. ReadyToRun is likewise not set here — it is applied
             only by the WinGet publish step, never by the NuGet package. -->
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="System.CommandLine"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\lib\WCountLib\WCountLib.csproj" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Update="Localizations\Resources.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Localizations\Resources.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>Resources.resx</DependentUpon>
      </Compile>
    </ItemGroup>

</Project>
