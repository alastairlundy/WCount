<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>disable</ImplicitUsings>
		<LangVersion>14</LangVersion>
        <Nullable>enable</Nullable>
        <!-- The CLI is the single shipped product; the WCountLib package line is
             frozen at its last shipped version (3.0.0) and gets no new releases. -->
        <IsPackable>false</IsPackable>
        <Version>3.0.0</Version>
        <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Title>WCountLib</Title>
        <Authors>Alastair Lundy</Authors>
        <Description>Count the number of lines, words, characters, and/or bytes in specified files, strings, or IEnumerables of strings.</Description>
        <Copyright>Copyright (c) Alastair Lundy 2024-2026</Copyright>
        <RepositoryUrl>https://github.com/alastairlundy/WCount</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <PackageReleaseNotes>* Package line frozen at last shipped version 3.0.0 — no new WCountLib versions will be published; the wcount CLI (WCount package) is the single shipped product.
* Folded WCountLib.Abstractions into this project; removed the unused Polyfill and Microsoft.Extensions.Primitives dependencies.</PackageReleaseNotes>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageTags>word counter, wc, word count, count</PackageTags>
        <PackageId>WCountLib</PackageId>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="README.md">
            <Link>README.md</Link>
            <PackagePath>README.md</PackagePath>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>
